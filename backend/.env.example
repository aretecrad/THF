# Where the dashboard is opened. Logins redirect back here; use https:// in production.
APP_URL=http://localhost:3000

# Threads app: App Dashboard > App settings > Basic > Threads app ID / Threads app secret
THREADS_APP_ID=
THREADS_APP_SECRET=
# Add this exact URL to "Valid OAuth redirect URIs". Defaults to $APP_URL/api/auth/threads/callback
# THREADS_REDIRECT_URI=

# Generate each with: openssl rand -base64 32   (required when NODE_ENV=production)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Read comments to fill in missing prices and places, and to find offers made as comments
READ_COMMENTS=true
MAX_COMMENT_FETCHES_PER_REFRESH=100

# Your email; OpenStreetMap's geocoder asks callers to identify themselves
NOMINATIM_EMAIL=
GEO_COUNTRY=id
# Optional "lat,lng": prefer geocoder matches near this point
GEO_BIAS=
MAX_GEOCODE_PER_REFRESH=400

PORT=4000
HOST=localhost

# Which proxies may set X-Forwarded-For, so rate limits see the real client IP.
# Default "loopback" fits the Next.js frontend on the same machine. Use "true" only when
# the backend can't be reached directly (e.g. docker-compose.yml), or list proxy IPs/CIDRs.
# TRUST_PROXY=loopback

# SQLite file holding users, logins, listings and sessions. Relative to the backend folder.
DATABASE_PATH=data/thf.db
# Listings posted (or, without a post date, fetched) longer ago than this are deleted daily.
LISTING_RETENTION_DAYS=365

# Optional Slack or Discord webhook: crashes, 500 errors and failed background jobs are posted here.
ALERT_WEBHOOK_URL=
